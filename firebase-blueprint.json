        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update server timestamp"
        }
      },
      "required": [
        "ownerId",
        "signers",
        "activeSignerIds",
        "signPlace",
        "letterhead",
        "customTitles",
        "updatedAt"
      ]
    },

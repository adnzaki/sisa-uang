{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Trusted administrator membership record keyed by user UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Administrator user UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Administrator email address",
          "minLength": 3,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "User profile and access control record (adapted from CodeIgniter 4 Shield).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth or migrated UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "description": "Unique login username",
          "minLength": 1,
          "maxLength": 60
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address (PII isolated to owner and admin)",
          "minLength": 3,
          "maxLength": 120
        },
        "displayName": {
          "type": "string",
          "description": "User display name or username",
          "minLength": 1,
          "maxLength": 80
        },
        "passwordHash": {
          "type": "string",
          "description": "Hashed password from legacy Shield migration",
          "maxLength": 255
        },
        "role": {
          "type": "string",
          "description": "RBAC role",
          "enum": ["user", "admin"]
        },
        "status": {
          "type": "string",
          "description": "Account access status",
          "enum": ["active", "blocked"]
        },
        "authProvider": {
          "type": "string",
          "description": "Authentication provider used",
          "enum": ["password", "google"]
        },
        "currency": {
          "type": "string",
          "description": "Preferred display currency",
          "enum": ["IDR", "USD"]
        },
        "subscriptionStatus": {
          "type": "string",
          "description": "SisaUang Pro subscription tier status",
          "enum": ["free", "pending", "pro"]
        },
        "subscriptionPlan": {
          "type": "string",
          "description": "SisaUang Pro subscription billing cycle",
          "enum": ["monthly", "yearly"]
        },
        "subscriptionExpiresAt": {
          "type": "string",
          "description": "Subscription expiration date (YYYY-MM-DD)",
          "maxLength": 40
        },
        "isPro": {
          "type": "boolean",
          "description": "Whether the user has an active SisaUang Pro subscription"
        },
        "isExplicitlyDeactivated": {
          "type": "boolean",
          "description": "Explicit deactivation flag by Super Admin preventing auto-reactivation from stale client/offline cache"
        },
        "subscriptionPaymentMethod": {
          "type": "string",
          "description": "Payment method chosen (qris, bank_transfer)",
          "maxLength": 40
        },
        "subscriptionProofDataUrl": {
          "type": "string",
          "description": "Base64 data URL of payment receipt or transfer proof",
          "maxLength": 2000000
        },
        "subscriptionProofFileName": {
          "type": "string",
          "description": "Uploaded proof image filename",
          "maxLength": 120
        },
        "subscriptionRequestedAt": {
          "type": "string",
          "description": "Timestamp when Pro activation was requested",
          "maxLength": 40
        },
        "subscriptionSenderName": {
          "type": "string",
          "description": "Sender bank account or e-wallet name",
          "maxLength": 80
        },
        "subscriptionTransferNote": {
          "type": "string",
          "description": "User transfer notes or transaction reference",
          "maxLength": 200
        },
        "deleted": {
          "type": "boolean",
          "description": "Soft-delete flag preserving historical records"
        },
        "deletedAt": {
          "type": "string",
          "description": "Soft-delete timestamp or null",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account update server timestamp"
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "role",
        "status",
        "authProvider",
        "currency",
        "createdAt",
        "updatedAt"
      ]
    },
    "Wallet": {
      "title": "Wallet",
      "description": "Sumber Dana utama (e.g., Mandiri, BCA, Dompet Tunai, GoPay).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "User account UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Sumber dana name",
          "minLength": 1,
          "maxLength": 60
        },
        "type": {
          "type": "string",
          "description": "Wallet category type",
          "enum": ["cash", "bank", "ewallet", "investment", "credit"]
        },
        "balance": {
          "type": "number",
          "description": "Aggregate wallet balance across all fund owners"
        },
        "color": {
          "type": "string",
          "description": "Accent color identifier",
          "minLength": 1,
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp"
        }
      },
      "required": [
        "ownerId",
        "name",
        "type",
        "balance",
        "color",
        "createdAt",
        "updatedAt"
      ]
    },
    "WalletOwner": {
      "title": "WalletOwner",
      "description": "Kepemilikan Dana di dalam satu Sumber Dana (misal: Mandiri -> Pribadi, Istri).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "User account UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "walletId": {
          "type": "string",
          "description": "Parent Sumber Dana (Wallet) ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "walletName": {
          "type": "string",
          "description": "Parent Sumber Dana name snapshot",
          "minLength": 1,
          "maxLength": 60
        },
        "holderName": {
          "type": "string",
          "description": "Nama pemilik dana (contoh: Pribadi, Istri, Anak)",
          "minLength": 1,
          "maxLength": 60
        },
        "balance": {
          "type": "number",
          "description": "Saldo spesifik milik pemilik dana ini di dalam sumber dana tersebut"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp"
        }
      },
      "required": [
        "ownerId",
        "walletId",
        "walletName",
        "holderName",
        "balance",
        "createdAt",
        "updatedAt"
      ]
    },
    "Category": {
      "title": "Category",
      "description": "Master kategori transaksi pemasukan dan pengeluaran.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "User account UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Nama kategori",
          "minLength": 1,
          "maxLength": 50
        },
        "type": {
          "type": "string",
          "description": "Jenis kategori transaksi",
          "enum": ["income", "expense"]
        },
        "color": {
          "type": "string",
          "description": "Warna label kategori",
          "minLength": 1,
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp"
        }
      },
      "required": [
        "ownerId",
        "name",
        "type",
        "color",
        "createdAt",
        "updatedAt"
      ]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Transaksi keuangan (income, expense, atau transfer antar sumber dana dan kepemilikan dana).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "User account UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "walletId": {
          "type": "string",
          "description": "Sumber dana ID asal",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "walletName": {
          "type": "string",
          "description": "Nama sumber dana asal",
          "minLength": 1,
          "maxLength": 60
        },
        "fundOwnerId": {
          "type": "string",
          "description": "ID kepemilikan dana asal",
          "minLength": 0,
          "maxLength": 128
        },
        "fundOwnerName": {
          "type": "string",
          "description": "Nama pemilik dana asal (misal: Pribadi, Istri)",
          "minLength": 0,
          "maxLength": 60
        },
        "toWalletId": {
          "type": "string",
          "description": "Sumber dana tujuan (khusus transaksi transfer)",
          "minLength": 0,
          "maxLength": 128
        },
        "toWalletName": {
          "type": "string",
          "description": "Nama sumber dana tujuan (khusus transaksi transfer)",
          "minLength": 0,
          "maxLength": 60
        },
        "toFundOwnerId": {
          "type": "string",
          "description": "ID kepemilikan dana tujuan (khusus transaksi transfer)",
          "minLength": 0,
          "maxLength": 128
        },
        "toFundOwnerName": {
          "type": "string",
          "description": "Nama pemilik dana tujuan (khusus transaksi transfer)",
          "minLength": 0,
          "maxLength": 60
        },
        "type": {
          "type": "string",
          "description": "Jenis transaksi: income, expense, atau transfer",
          "enum": ["income", "expense", "transfer"]
        },
        "category": {
          "type": "string",
          "description": "Nama kategori transaksi",
          "minLength": 1,
          "maxLength": 50
        },
        "amount": {
          "type": "number",
          "description": "Nominal transaksi positif"
        },
        "adminFee": {
          "type": "number",
          "description": "Biaya admin tambahan untuk transaksi transfer (opsional)"
        },
        "note": {
          "type": "string",
          "description": "Catatan transaksi",
          "minLength": 0,
          "maxLength": 200
        },
        "date": {
          "type": "string",
          "description": "Tanggal transaksi (YYYY-MM-DD)",
          "minLength": 8,
          "maxLength": 30
        },
        "automationRuleId": {
          "type": "string",
          "description": "ID aturan otomatisasi jika transaksi berasal dari jadwal otomatis",
          "maxLength": 128
        },
        "attachments": {
          "type": "array",
          "description": "Daftar lampiran bukti pembelanjaan (invoice/kwitansi PDF atau gambar) yang disimpan di Cloudflare R2",
          "maxItems": 10,
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "maxLength": 80 },
              "key": { "type": "string", "maxLength": 300 },
              "name": { "type": "string", "maxLength": 160 },
              "mimeType": { "type": "string", "maxLength": 80 },
              "size": { "type": "number" },
              "uploadedAt": { "type": "string", "maxLength": 40 }
            },
            "required": ["id", "key", "name", "mimeType", "size", "uploadedAt"]
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update server timestamp"
        }
      },
      "required": [
        "ownerId",
        "walletId",
        "walletName",
        "type",
        "category",
        "amount",
        "note",
        "date",
        "createdAt",
        "updatedAt"
      ]
    },

    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Real-time user and system audit log entry for Super Admin monitoring.",
      "type": "object",
      "properties": {
        "actorUid": {
          "type": "string",
          "description": "UID of the user performing the action",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorEmail": {
          "type": "string",
          "description": "Email of the actor",
          "minLength": 3,
          "maxLength": 120
        },
        "action": {
          "type": "string",
          "description": "Action identifier code",
          "minLength": 2,
          "maxLength": 60
        },
        "detail": {
          "type": "string",
          "description": "Human-readable audit description",
          "minLength": 1,
          "maxLength": 250
        },
        "severity": {
          "type": "string",
          "description": "Audit severity level",
          "enum": ["info", "warning", "critical"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the event"
        }
      },
      "required": [
        "actorUid",
        "actorEmail",
        "action",
        "detail",
        "severity",
        "createdAt"
      ]
    },
    "SecurityAlert": {
      "title": "SecurityAlert",
      "description": "Instant suspicious activity alert surfaced in the Super Admin control panel.",
      "type": "object",
      "properties": {
        "actorUid": {
          "type": "string",
          "description": "UID associated with the suspicious event",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorEmail": {
          "type": "string",
          "description": "Email associated with the suspicious event",
          "minLength": 3,
          "maxLength": 120
        },
        "title": {
          "type": "string",
          "description": "Short alert title",
          "minLength": 3,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "description": "Detailed explanation of suspicious trigger",
          "minLength": 3,
          "maxLength": 300
        },
        "severity": {
          "type": "string",
          "description": "Threat severity level",
          "enum": ["warning", "critical"]
        },
        "status": {
          "type": "string",
          "description": "Resolution status of the alert",
          "enum": ["open", "resolved"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Resolution update server timestamp"
        }
      },
      "required": [
        "actorUid",
        "actorEmail",
        "title",
        "description",
        "severity",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "ReportSettings": {
      "title": "ReportSettings",
